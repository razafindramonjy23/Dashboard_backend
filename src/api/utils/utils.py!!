from django.core.management.base import BaseCommand
from api.models.metrics import CampaignMetrics
from django.db.models import F
from django.db import transaction
import tldextract
import logging

logger = logging.getLogger(__name__)


class Command(BaseCommand):
    help = 'Met à jour les domain_family pour toutes les métriques de campagne'

    def add_arguments(self, parser):
        parser.add_argument(
            '--batch-size',
            type=int,
            default=1000,
            help='Nombre d\'enregistrements à traiter par lot'
        )

    def handle(self, *args, **options):
        batch_size = options['batch-size']
        total_updated = 0
        
        try:
            # Récupération des métriques sans domain_family
            metrics = CampaignMetrics.objects.select_related('database').filter(
                domain_family__in=['', None]
            )
            
            total_records = metrics.count()
            self.stdout.write(f"Traitement de {total_records} enregistrements...")

            # Traitement par lots
            with transaction.atomic():
                for metric in metrics.iterator(chunk_size=batch_size):
                    try:
                        # Extraction du domain_family à partir du nom de la base
                        domain_family = get_domain_family(metric.database.name)
                        
                        # Mise à jour de l'enregistrement
                        metric.domain_family = domain_family
                        metric.save(update_fields=['domain_family'])
                        
                        total_updated += 1
                        
                        if total_updated % 1000 == 0:
                            self.stdout.write(f"Progression: {total_updated}/{total_records}")
                            
                    except Exception as e:
                        logger.error(f"Erreur lors du traitement de la métrique {metric.id}: {str(e)}")

            self.stdout.write(
                self.style.SUCCESS(f'Mise à jour terminée. {total_updated} enregistrements traités.')
            )

        except Exception as e:
            logger.error(f"Erreur lors de l'exécution du script: {str(e)}")
            self.stdout.write(
                self.style.ERROR(f'Erreur lors de la mise à jour: {str(e)}')
            )